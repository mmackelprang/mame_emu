// DRC native bus-step descriptors (O-mem-1 btst-absolute + O-mem-2
// bit-ops (An)/(An)+/-(An), #imm8/Dn source).
// Each step's -charge and substate pair are taken from the SAME
// microcode walk as the interpreter handler (drc_bus_steps() parses
// the very text generate_source_from_code emits for the handler), so
// they cannot drift from the interpreter (ADR 0007 OQ-2).
enum drc_bus_kind : u8 {
	DRC_BUS_PREFETCH_READ = 0, // m_opcodes.read_interruptible, SSW_PROGRAM
	DRC_BUS_DATA_READ     = 1, // m_program.read_interruptible, SSW_DATA, byte-lane
	DRC_BUS_DATA_WRITE    = 2  // m_program.write_interruptible, SSW_DATA, byte-lane
};

struct drc_bus_step {
	u8 kind; u8 size; u8 charge;
	u8 redo_substate; u8 completed_substate;
	u8 has_addr_error; u8 byte_lane; u8 pre_charge;
};
struct drc_bus_run { u16 value; u16 mask; u16 first; u16 count; };

